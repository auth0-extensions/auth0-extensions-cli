#!/usr/bin/env node

const fs = require("node:fs");
const util = require("node:util");

const _ = require("lodash");
const chalk = require("chalk");
const path = require("path");
const prog = require("caporal");
const Webpack = require("webpack");
const validator = require("webtask-json-validator");
const AdmZip = require("adm-zip");

const getConfig = require("../lib/config");
const getExternals = require("../lib/externals");
const getClientConfig = require("../lib/client-config");

async function json(filepath) {
  return JSON.parse(fs.readFileSync(filepath, "utf-8"));
}

const rootPath = process.cwd();

prog
  .version("1.0.0")
  .command(
    "build:server",
    "Compile your Node.js Backend into an Auth0 Extension"
  )
  .argument("entry", "Entrypoint for your extension", prog.STRING)
  .argument(
    "destination",
    "Folder to store the output of the build to",
    prog.STRING
  )
  .option("--pkg <pkg>", "Path of package.json", prog.STRING, "package.json")
  .option(
    "--runtime <runtime>",
    "Runtime to execute the extension (node12|node16|node18|node22)",
    /node12|node16|node18|node22/,
    "node12"
  )
  .option(
    "--mode <mode>",
    "Build mode (development|production)",
    /^development|production$/,
    "development"
  )
  .action(async (args, opts) => {
    const packagePath = path.join(rootPath, opts.pkg);
    const pkg = await json(packagePath);
    console.log(
      "Building:",
      chalk.bold(`${pkg.name}@${pkg.version} extension`)
    );

    const externals = await getExternals(rootPath, opts.runtime);
    const config = getConfig(pkg, rootPath, externals, args, opts);
    const webpack = Webpack(config);
    const stats = await util.promisify(webpack.run).bind(webpack)();

    const chunks = stats.toJson({ chunks: true }).chunks;
    console.log(
      "Output:",
      chalk.bold(`${path.join(args.destination, chunks[0].files[0])}`)
    );

    const largeModules = _.chain(chunks[0].modules)
      .orderBy(["size"], ["desc"])
      .filter((m) => m.size > 5000)
      .value();
    if (largeModules && largeModules.length) {
      largeModules.forEach((m) =>
        console.log(` - ${m.name} (${Math.round(m.size / 1024)} KB)`)
      );
    }

    console.log(
      `\n${stats.toString({
        colors: true,
        cached: false,
        cachedModules: false,
      })}`
    );
  })
  .command(
    "build:client",
    "Compile your React Frontend into an Auth0 Extension Client"
  )
  .argument(
    "entry",
    "Entrypoint for your extension",
    prog.STRING,
    "client/app.jsx"
  )
  .argument(
    "destination",
    "Folder to store the output of the build to",
    prog.STRING,
    "dist"
  )
  .option("--pkg <pkg>", "Path of package.json", prog.STRING, "package.json")
  .option(
    "--mode <mode>",
    "Build mode (development|production)",
    /^development|production$/,
    "development"
  )
  .action(async (args, opts) => {
    const packagePath = path.join(rootPath, opts.pkg);

    const pkg = await json(packagePath);
    console.log("Building:", chalk.bold(`${pkg.name}@${pkg.version} client`));
    const config = getClientConfig(pkg, rootPath, args, opts);

    const webpack = Webpack(config);
    const stats = await util.promisify(webpack.run).bind(webpack)();

    console.log(
      stats.toString({
        colors: true,
        cached: false,
        cachedModules: false,
      })
    );
  })
  .command(
    "validate",
    "Check extension`s package.json to contain all necessary information"
  )
  .argument(
    "entry",
    "Entrypoint for your extension",
    prog.STRING,
    "package.json"
  )
  .action(async (args) => {
    const packagePath = path.join(rootPath, args.entry);

    const pkg = await json(packagePath);
    console.log(`Validating ${packagePath}`);

    const result = validator.validate(pkg, true);

    if (result.isValid) {
      console.log(`${packagePath} is valid.`);
      return process.exit(0);
    }

    console.log(`${packagePath} is invalid.`, result.errors);
    return process.exit((result.errors && result.errors.length) || 1);
  })
  .command("package", "Package assets for extension deployment")
  .option("--pkg <pkg>", "Path of package.json", prog.STRING, "package.json")
  .option("--client <client>", "Path of client side assets")
  .option("--bundle <bundle>", "Path to extensions bundle")
  .option("--out <out>", "Directory to copy build package")
  .action((args, opts) => {
    const packagePath = path.join(rootPath, opts.pkg);

    json(packagePath).then((pkg) => {
      console.log(`Validating ${packagePath}`);

      const result = validator.validate(pkg, true);

      if (!result.isValid) {
        console.log(`${packagePath} is invalid.`, result.errors);
        return process.exit((result.errors && result.errors.length) || 1);
      }

      const clientPath = opts.client ? path.join(rootPath, opts.client) : null;
      const bundlePath = path.join(
        rootPath,
        opts.bundle || `./dist/${pkg.name}.extension.${pkg.version}.js`
      );
      const outPath = path.join(
        rootPath,
        opts.out || pkg["auth0-extension"].main
      );

      console.log(
        "Packaging:",
        chalk.bold(`${pkg.name}@${pkg.version} extension assets`)
      );

      const zip = new AdmZip();

      zip.addLocalFile(packagePath);
      zip.addLocalFile(bundlePath, "", "extension.js");
      if (clientPath) {
        zip.addLocalFolder(
          clientPath,
          "client",
          (filename) => filename.endsWith(".js") || filename.endsWith(".css")
        );
      }

      const zipName = path.join(outPath, "package.zip");

      return zip.writeZip(zipName, (err) => {
        if (err) {
          console.log("Error:", `Unable to package ${zipName}`);
          return process.exit(1);
        }

        console.log(`${zipName} packaged successfully`);
        return process.exit(0);
      });
    });
  })
  .command("deploy", "Deploys the extension to Auth0.")
  .option(
    "--apiKey <apiKey>",
    "API Key",
    prog.STRING,
    process.env.AUTH0_EXTENSIONS_API_KEY
  )
  .option(
    "--package <package>",
    "Path to extension bundle",
    prog.STRING,
    "dist/package.zip"
  )
  .option(
    "--url <url>",
    "URL to extension deploy endpoint",
    prog.STRING,
    "http://0.0.0.0:3000/api/extensions"
  )
  .action((args, opts) => {
    const { url, apiKey, package } = opts;
    const filePath = path.join(rootPath, package);

    if (!apiKey) {
      console.error(
        "An API key is required. Please set --apiKey flag or set the environment variable AUTH0_EXTENSIONS_API_KEY"
      );
      return process.exit(1);
    }

    const data = new FormData();
    data.append("package", new Blob([fs.readFileSync(filePath)]), filePath);

    return fetch(url, {
      method: "POST",
      headers: {
        "x-api-key": apiKey,
      },
      body: data,
    }).then(
      () => {
        console.log("Extension has been deployed successfully");
        return process.exit(0);
      },
      (err) => {
        console.log("Deploy process failed");
        console.log((err.response && err.response.error) || err);
        return process.exit(1);
      }
    );
  });

prog.parse(process.argv);
